.vscode/
config/config.yml
# Settings keeps the copy before each change (Revert Settings)
config/config.yml.bak
config/config.yml.tmp
# Health check thresholds (Settings > Health Check Thresholds), created from skeleton_health_checks.yaml
config/health_checks.yaml
config/health_checks.yaml.bak
config/health_checks.yaml.tmp
.venv/
__pycache__/
# Generated by 'poetry lock' at install time
poetry.lock
# PyInstaller output (build_exe.ps1)
build/
dist/
*.spec
# Run logs (log_folder in config.yml)
logs/
# Local data file - your firewall inventory (data_file in config.yml)
data/
